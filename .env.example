# Supabase — Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 마스터 키 — 절대 클라이언트/깃에 노출 금지 (신형 키: sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# 마이그레이션 CLI 적용용(scripts/db-apply.mjs) — Dashboard → Connect → Session pooler URI.
# 주의: DB 비밀번호에 #·@ 등 특수문자가 있으면 반드시 percent-encoding 해서 넣을 것.
SUPABASE_DB_URL=

# 앱
NEXT_PUBLIC_APP_URL=http://localhost:3000
